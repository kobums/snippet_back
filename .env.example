# 이 파일을 .env (또는 .env.local / .env.production) 로 복사한 뒤 실제 값을 채운다. 실제 값은 절대 커밋하지 말 것.
DB_URL=jdbc:mariadb://localhost:3306/snippet
DB_USERNAME=snippet
DB_PASSWORD=change-me

# Base64 인코딩된 256bit 이상 키 (예: openssl rand -base64 48)
JWT_SECRET=change-me-base64

CORS_ALLOWED_ORIGINS=http://localhost:3000
ADMIN_EMAILS=admin@example.com

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

ALADIN_API_KEY=
ALADIN_TTB_KEY=
DATA4LIBRARY_AUTH_KEY=
NATIONAL_LIBRARY_KEY=
KYOBO_PARTNER_ID=
YES24_PARTNER_ID=

NAVER_CLOVA_API_URL=
NAVER_CLOVA_SECRET_KEY=

# 서비스 계정 JSON 파일 경로 (파일 자체는 커밋 금지)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CREDENTIALS=

APP_MIN_VERSION_IOS=
APP_LATEST_VERSION_IOS=
APP_MIN_VERSION_ANDROID=
APP_LATEST_VERSION_ANDROID=
APP_UPDATE_MESSAGE=
